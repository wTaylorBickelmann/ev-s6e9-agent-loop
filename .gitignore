.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Kaggle credentials and competition data — never commit
kaggle.json
.kaggle/
data/raw/*
!data/raw/.gitkeep
data/processed/
*.csv
!sample_submission.example.csv
!ledger/runs_history.csv

# Long experiment output — never commit, never feed to the planner
logs/*
!logs/.gitkeep
!logs/README.md
ledger/runs/*.json
!ledger/runs/.gitkeep
outputs/*
!outputs/.gitkeep
exps/**/oof.csv
*.pkl
*.joblib
*.lgb
*.log

# CatBoost training artifacts (auto-generated during runs)
catboost_info/

# Outside-repo cache is not in this tree; keep a local override note only via .env
.qwenignore.local

# Generated site / notebook junk
_site/

# Noise / caches
.ipynb_checkpoints/
__marimo__/
.marimo/
.qwen/
.DS_Store
reports/kills/
reports/plans/
reports/*.png
reports/*.svg
notebooks/
