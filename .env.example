# Copy to .env and adjust. Values here override config/loop.yaml via ${VAR:-default}.

# --- Paths ---------------------------------------------------------------
COMPETITION_ROOT=.
# Long traces OUTSIDE the git tree so Qwen Code cannot bulk-ingest them from cwd.
# Relative values still resolve under the repo root.
LOOP_LOGS_DIR=~/.cache/ev-s6e9-agent-loop/logs

# --- Planner: Antigravity (primary) --------------------------------------
# Install: curl -fsSL https://antigravity.google/cli/install.sh | bash
# List account models:  agy models
AGY_BIN=agy
AGY_MODEL=claude-opus-4-6-thinking
AGY_EFFORT=high
# LOOP_DISABLE_ANTIGRAVITY=0

# --- Planner: DeepSeek fallback (OpenAI-compatible + agent harness) ------
# Prefer llama-server with --agent (built-in tool harness), not bare Ollama:
#   bash scripts/serve_deepseek_harness.sh
#   # or: ./scripts/restart_agent.sh deepseek up
# Weights default: ~/Models/deepseek-v4-flash-q3/UD-Q3_K_M
# Keep DeepSeek DOWN while agy works — only start on fallback.
DEEPSEEK_BASE_URL=http://127.0.0.1:8080/v1
DEEPSEEK_MODEL=deepseek-v4-flash-q3
DEEPSEEK_API_KEY=local

# --- Executor: Qwen Code + local Qwen ------------------------------------
QWEN_BIN=qwen
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3.8:27b-q4_K_M
OPENAI_API_KEY=ollama
# QWEN_AUTH_TYPE=openai
QWEN_CODE_SUPPRESS_YOLO_WARNING=1

# --- Train process pool (optional) ---------------------------------------
# Independent seed/variant/fold workers. Default: min(tasks, CPU count).
# EV_S6E9_TRAIN_WORKERS=8
