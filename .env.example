# Copy to .env and adjust. Values here override config/loop.yaml via ${VAR:-default}.

# --- Paths ---------------------------------------------------------------
# LOOP_ROOT defaults to the current working directory (this repo).
# LOOP_ROOT=.

# This instance vendors the S6E9 library. Leave competition root at this repo.
COMPETITION_ROOT=.

# --- Planner: Antigravity (primary) --------------------------------------
# List account models:  agy models
# Pass the left-column slug (recommended) or the display name.
AGY_BIN=agy
AGY_MODEL=gemini-3.5-flash-high
AGY_EFFORT=high
# Set to 1 to skip agy and go straight to local DeepSeek.
# LOOP_DISABLE_ANTIGRAVITY=0

# --- Planner: DeepSeek fallback (OpenAI-compatible) ----------------------
DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1
DEEPSEEK_MODEL=deepseek-r1:32b
DEEPSEEK_API_KEY=ollama

# --- Executor: Qwen Code + local Qwen ------------------------------------
QWEN_BIN=qwen
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3.6:27b
OPENAI_API_KEY=ollama
# QWEN_AUTH_TYPE=openai
